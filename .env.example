# --- apps/web (Vite: VITE_ 接頭辞のものだけがブラウザに露出する) ---
# ローカル Supabase を使う場合は `supabase start` の出力をそのまま貼る
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- apps/cron (Cloudflare Workers / wrangler secret put で登録する) ---
# service_role キーはブラウザに絶対に出さない。Worker 側の secret としてのみ扱う。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
ALERT_MAIL_TO=
